# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed: it is the only record of what a new
# machine or a fresh deploy needs configured. It holds names, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private docs — only README.md is committed; all other .md files are local
*.md
!README.md
docs/
/anis media/

/src/generated/prisma

# Serwist (PWA service worker — generated at build time)
public/sw*
public/swe-worker*
