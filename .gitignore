# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local documentation (only root README.md is committed)
docs/
# Project summary: local reference only — never commit
docs/projectsummary.md
# Production readiness: local reference only — never commit
PRODUCTION_READINESS.md
# Setup docs and media — not for repo (keep only README.md)
SUPABASE-SETUP.md
COST-PRICE-SETUP.md
/anis media/

/src/generated/prisma

# Serwist (PWA service worker — generated at build time)
public/sw*
public/swe-worker*

# Local test credentials (generated by seed — never commit)
LOCAL-TEST-CREDENTIALS.md
