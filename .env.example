# Anis Food and Drink — environment variables
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Both come from Supabase → Project Settings → Database → Connection string.
# Percent-encode any special characters in the password (? → %3F, % → %25).
#
# DATABASE_URL is the transaction pooler (port 6543) used by the app at runtime.
# DIRECT_URL is the session pooler (port 5432) used for migrations.
#
# Note: if the session pooler is unavailable on your project, migrations still
# work — scripts/db-migrate.mjs applies plain SQL over the transaction pooler.
# See the comment at the top of that file.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Storage (menu image uploads via admin)
# ---------------------------------------------------------------------------
# The service role key bypasses row-level security. Server-side only — never
# expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="menu"

# ---------------------------------------------------------------------------
# Auth — session cookie signing
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Rotating this signs everyone out, which is the intended emergency response to
# a suspected leak.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Site URL (sitemap, robots, metadata)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://aniseatery.com"
